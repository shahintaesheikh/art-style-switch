# ---- BytePlus ModelArk ----
ARK_API_KEY=<your-modelark-api-key>
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# ---- Local input paths (ffmpeg processing + base64 for Seedream) ----
INPUT_VIDEO=/path/to/unity-5.mp4
STYLE_REF=/path/to/handDrawnStyle.jpeg

# ---- ModelArk Asset Library URIs (console upload; Seedance references) ----
INPUT_VIDEO_URI=asset://asset-XXXXXXXXXXXXXX-XXXXX
STYLE_REF_URI=asset://asset-XXXXXXXXXXXXXX-XXXXX

# ---- Working directory (created for you) ----
WORK_DIR=./work
